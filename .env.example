# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=PASTE_YOUR_OWN_TELEGRAM_BOT_TOKEN_HERE

# Required: Your numeric Telegram User ID (get it from @userinfobot)
# Multiple IDs can be separated by commas: 123456789,987654321
OWNER_ID=YOUR_NUMERIC_TELEGRAM_USER_ID

# Optional: Parallel TTS chunk requests (1-6 recommended on Oracle Cloud; default: 3)
TTS_CONCURRENCY=3

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
